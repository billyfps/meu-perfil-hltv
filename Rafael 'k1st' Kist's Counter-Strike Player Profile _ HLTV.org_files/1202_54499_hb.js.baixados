        }
      },
      "template": "<div class='presented-by-row'> <h1><a class='a-reset'>PROMOTED GAMES</a></h1> </div> <div class='col-box-con'> {{~it.creatives :val:i}}<a href='{{=val.clickUrl}}' target='_blank' ><h4 class='col-box' style='padding: 5px; margin-top: 0px; margin-bottom: 0px; border-bottom: 1px solid lightgray'> <img height='24px' width='24px' style='margin-right: 5px; vertical-align: middle' alt='' src='{{=val.thumbUrl}}' /><span style='color: #2d6da3; font-family: Open Sans, sans-serif; -webkit-text-size-adjust: 100%; font-size: 11px;'>{{=val.title}}<br></span> <span style='color: #2d6da3; font-family: Open Sans, sans-serif; -webkit-text-size-adjust: 100%; font-size: 11px; font-weight: lighter; line-height: 1.5; display: inline-block; padding-top:2px'>{{=val.description}}</span>  </h4></a>{{~}} </div> "
    }
  ],
